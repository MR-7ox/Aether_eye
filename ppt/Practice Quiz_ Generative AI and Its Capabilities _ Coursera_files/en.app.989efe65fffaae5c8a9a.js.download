tor - Florida Museum of History"}],168:[{text:"The course improved my knowledge in the field, and the Course Certificate gives me a lot more credibility.",student:"Clayton S.",title:"Business Development Manager"},{text:"I'm using what I learned in the course to develop new products in my company, one of the oldest and most respected newspapers in Brazil.",student:"Nelson P.",title:"CIO from Brazil"},{text:"After the course, I was inspired to write the business plan for my start-up. My certificate proves what I’ve accomplished!",student:"Florian A.",title:"Account Manager from Switzerland"},{text:"By showing my Course Certificate to my employer, I was able to get support to turn my idea into a new project.",student:"Sebastian S.",title:"Programmer from Costa Rica"}],747:[{text:"This course helped me identify a target market and understand aspects of marketing that I hadn't been aware of, and for that I am grateful. I'll use the certificate I received from Coursera as a seal of approval for my work.",student:"Bartholomew N.",title:"Director of Fundraising at WQED in Pittsburgh, PA"},{text:"The course validated the analytics functions we’ve instituted within our company. And the Course Certificate validates my skill set.",student:"Michael D.",title:"Director of Sales from Portland"},{text:"Learning is a never-ending process. Now I know what needs to get done before I start rebranding my company.",student:"Saundra L.",title:"CEO from Miami, Florida"},{text:"My employers were happy to hear that I'd completed the course. The Course Certificate shows my dedication to performing better at my current position.",student:"Stephanie N.",title:"Marketing Communications Manager from Newark, Delaware"}]}}},"//LS":function(module,i,a){"use strict";var o=a("2T55"),s=a("1R1p"),ee=function(){function EvaluationRunner(i){this.evaluatorId=i,this.evaluation=new o.a({})}var i=EvaluationRunner.prototype;return i.run=function(i,a){var ee=this;this.evaluation=new o.a({active:!0}),a(this.eva