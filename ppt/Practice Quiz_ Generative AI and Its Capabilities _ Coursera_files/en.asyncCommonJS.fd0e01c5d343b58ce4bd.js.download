uestion_FormElementNode\n  }\n}\n\nfragment Grading_ManuallyGradedQuestion_FormElementNode on AssignmentPresentations_FormElementNode {\n  element {\n    __typename\n    ...Grading_ManuallyGradedQuestion_FormElementNode_Element\n  }\n}\n\nfragment Grading_ManuallyGradedQuestion_FormElementNode_Element on AssignmentPresentations_FormElementPromptWithResponseElement {\n  courierTypeName\n  score {\n    ...Grading_Score\n  }\n  prompt {\n    ...Grading_PromptSubmissionPrompt\n  }\n  responseId\n  response {\n    ...Grading_ManuallyGradedQuestion_Response\n  }\n}\n\nfragment Grading_Score on AssignmentPresentations_Score {\n  points\n  maxPoints\n}\n\nfragment Grading_PromptSubmissionPrompt on AssignmentPresentations_PromptSubmissionPrompt {\n  promptId: id\n  courierTypeName\n  promptContent {\n    ...Grading_Content\n  }\n  plagiarismConfig {\n    plagiarismCheckEnable\n  }\n  submissionPartSchemaDetails {\n    ...Grading_SubmissionPartSchemaDetails\n  }\n  graderType\n}\n\n# Question Response\nfragment Grading_ManuallyGradedQuestion_Response on AssignmentPresentations_ResponseSubmissionResponse {\n  courierTypeName\n  submissionPartResponse {\n    ...Grading_SubmissionPartResponse\n  }\n}\n\n# Question Prompt: SubmissionPart Schema Details: PlainText\nfragment Grading_SubmissionPartSchemaDetails_PlainTextSchema on AssignmentPresentations_SubmissionPartSchemaDetailsPlainTextSchema {\n  courierTypeName\n}\n\n# Question Prompt: SubmissionPart Schema Details: File Upload\nfragment Grading_SubmissionPartSchemaDetails_FileUploadSchema on AssignmentPresentations_SubmissionPartSchemaDetailsFileUploadSchema {\n  courierTypeName\n  required\n}\n\n# Question Prompt: SubmissionPart Schema Details: URL\nfragment Grading_SubmissionPartSchemaDetails_UrlSchema on AssignmentPresentations_SubmissionPartSchemaDetailsUrlSchema {\n  courierTypeName\n  allowedUrls\n}\n\n# Question Prompt: SubmissionPart Schema Details: Rich Text\nfragment Grading_SubmissionPartSchemaDetails_RichTextSchema